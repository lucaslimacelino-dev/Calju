# =============================================================================
# CaLju — arquivos que o Git deve ignorar
# Regra geral: versionar código-fonte e configuração; nunca versionar arquivos
# gerados pela compilação, configurações pessoais da máquina ou segredos.
# =============================================================================

# --- Segredos e credenciais ---------------------------------------------------
# Variáveis de ambiente locais (senhas do banco, chave do JWT, SMTP etc.).
# Um modelo sem valores reais pode ser versionado como .env.example.
.env
.env.*
!.env.example

# Chaves e certificados
*.pem
*.key
*.p12
*.pfx

# Keystores de assinatura do Android e arquivo com as senhas delas
*.jks
*.keystore
keystore.properties

# --- Android / Gradle ---------------------------------------------------------
# Cache e saídas de compilação do Gradle
.gradle/
build/
# Caminho do Android SDK nesta máquina (cada computador tem o seu)
local.properties
# Saídas de ferramentas nativas e de captura do Android Studio
.externalNativeBuild/
.cxx/
captures/
# Pacotes gerados (são produzidos pela compilação, não editados à mão)
*.apk
*.aab
*.ap_
*.dex
# Relatórios do R8 (ofuscação/minificação)
mapping.txt
# Observação: gradle/wrapper/gradle-wrapper.jar DEVE ser versionado.

# --- Backend Java / Maven -----------------------------------------------------
# Pasta de saída do Maven (classes compiladas, .jar gerado, relatórios de teste)
target/
*.class
# Observação: .mvn/wrapper/maven-wrapper.properties DEVE ser versionado.

# --- Logs e arquivos temporários ----------------------------------------------
*.log
logs/
*.tmp
hs_err_pid*

# --- IDEs e editores ----------------------------------------------------------
# IntelliJ IDEA / Android Studio
.idea/
*.iml
out/
# VS Code
.vscode/
# Eclipse
.classpath
.project
.settings/
bin/

# --- Sistema operacional ------------------------------------------------------
# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
