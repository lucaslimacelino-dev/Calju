<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CaLju" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/primary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_primary_container</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceContainerLow">@color/surface_container</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <!-- Textos sem cor própria usam os tons da paleta, não os neutros padrão do Material. -->
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_variant</item>
        <!-- Cores "invertidas": avisos (Snackbar) escuros sobre o tema claro e vice-versa. -->
        <item name="colorSurfaceInverse">@color/inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/inverse_primary</item>
        <!-- Cartões na cor exata de "surface", sem o tingimento automático por elevação. -->
        <item name="elevationOverlayEnabled">false</item>
        <!-- Nunito em todo o app (textos sem estilo próprio e a escala do Material 3). -->
        <item name="android:fontFamily">@font/nunito</item>
        <item name="fontFamily">@font/nunito</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.CaLju.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.CaLju.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.CaLju.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.CaLju.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.CaLju.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.CaLju.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.CaLju.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.CaLju.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.CaLju.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.CaLju.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.CaLju.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.CaLju.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.CaLju.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.CaLju.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.CaLju.LabelSmall</item>
    </style>

    <style name="ThemeOverlay.CaLju.Summary" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">@color/on_summary</item>
        <item name="colorSecondary">@color/summary_accent</item>
        <item name="colorSecondaryContainer">@color/summary_accent</item>
        <item name="colorOnSecondaryContainer">@color/on_summary_accent</item>
        <item name="colorSurface">@color/summary_track</item>
        <item name="colorSurfaceContainer">@color/summary_tile</item>
        <item name="colorOutline">@color/summary_ring_track</item>
        <item name="colorOnSurface">@color/on_summary</item>
        <item name="colorOnSurfaceVariant">@color/on_summary_variant</item>
        <item name="android:textColorPrimary">@color/on_summary</item>
        <item name="android:textColorSecondary">@color/on_summary_variant</item>
    </style>

    <style name="Widget.CaLju.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="Widget.CaLju.SendButton" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="backgroundTint">?attr/colorSecondary</item>
        <item name="iconTint">?attr/colorOnSecondary</item>
    </style>

    <style name="Widget.CaLju.SectionAdd" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="backgroundTint">@color/add_button</item>
        <item name="iconTint">@color/on_add_button</item>
    </style>

    <style name="Widget.CaLju.PrimaryAction" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorSecondary</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.CaLju.UserBubble" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">end</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@drawable/bg_user_bubble</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.CaLju.CajuReply" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:gravity">bottom</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Widget.CaLju.CajuAvatar" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">47dp</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <style name="Widget.CaLju.CajuBubble" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">32dp</item>
        <item name="android:background">@drawable/bg_caju_bubble</item>
        <item name="android:elevation">1dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
    </style>

    <style name="Widget.CaLju.EmptyState" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">24dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

</resources>
