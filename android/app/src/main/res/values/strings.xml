    <string name="nutrient_info_FIBTG">Ajuda o intestino e dá saciedade.\nOnde tem: feijão, aveia, frutas e verduras.</string>
    <string name="nutrient_info_CA">Ossos e dentes.\nOnde tem: leite, queijo, iogurte e couve.</string>
    <string name="nutrient_info_FE">Leva oxigênio pelo sangue.\nOnde tem: carne vermelha, fígado, feijão e folhas verde-escuras.</string>
    <string name="nutrient_info_MG">Músculos e nervos.\nOnde tem: castanhas, feijão e aveia.</string>
    <string name="nutrient_info_K">Músculos e equilíbrio de líquidos.\nOnde tem: banana, feijão, batata e abacate.</string>
    <string name="nutrient_info_ZN">Defesa do corpo e cicatrização.\nOnde tem: carne vermelha, frango, feijão e castanhas.</string>
    <string name="nutrient_info_P">Ossos e dentes, junto com o cálcio.\nOnde tem: carnes, ovos, leite e feijão.</string>
    <string name="nutrient_info_CU">Ajuda o corpo a usar o ferro.\nOnde tem: fígado, castanhas e feijão.</string>
    <string name="nutrient_info_MN">Aproveitamento da energia.\nOnde tem: aveia, arroz integral e castanhas.</string>
    <string name="nutrient_info_VITC">Defesa do corpo e absorção do ferro.\nOnde tem: caju, acerola, goiaba e laranja.</string>
    <string name="nutrient_info_VITA_RAE">Visão e pele.\nOnde tem: cenoura, abóbora, manga, couve e fígado.</string>
    <string name="nutrient_info_VITB12">Sangue e nervos.\nOnde tem: carnes, peixes, ovos, leite e queijo. Quem não come esses alimentos costuma precisar de suplemento.</string>
    <string name="nutrient_info_THIA">Usa a energia dos carboidratos.\nOnde tem: carne de porco, feijão e aveia.</string>
    <string name="nutrient_info_RIBF">Transforma o alimento em energia.\nOnde tem: leite, ovos e carnes.</string>
    <string name="nutrient_info_VITB6A">Aproveitamento das proteínas.\nOnde tem: frango, peixe, banana e batata.</string>
    <string name="nutrient_info_NIA">Transforma o alimento em energia.\nOnde tem: frango, peixe, carne e amendoim.</string>
    <string name="nutrient_info_NA">Em excesso, aumenta a pressão.\nVem do sal e de industrializados: embutidos, salgadinhos e temperos prontos.</string>
    <string name="nutrient_info_CHOLE">Não há valor diário recomendado: o próprio corpo produz o colesterol de que precisa.\nOnde tem: ovos, carnes, miúdos e laticínios.</string>

