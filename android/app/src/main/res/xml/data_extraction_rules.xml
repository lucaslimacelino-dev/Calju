<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: os tokens da conta nunca vão para o backup nem para outro aparelho. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="calju_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="calju_auth.xml" />
    </device-transfer>
</data-extraction-rules>
