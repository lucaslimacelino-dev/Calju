<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/welcome_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingBottom="24dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/skip"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="@string/welcome_skip" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/page_hello"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_welcome_circle">

                    <ImageView
                        android:layout_width="160dp"
                        android:layout_height="187dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_caju_feliz" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:accessibilityHeading="true"
                    android:gravity="center"
                    android:text="@string/welcome_hello_title"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/welcome_hello_text"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/page_how"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:accessibilityHeading="true"
                    android:text="@string/welcome_how_title"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/welcome_how_text"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    style="@style/Widget.CaLju.UserBubble"
                    android:text="@string/welcome_how_user_1" />

                <LinearLayout
                    style="@style/Widget.CaLju.CajuReply"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        style="@style/Widget.CaLju.CajuAvatar"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_caju_comemorando" />

                    <TextView
                        style="@style/Widget.CaLju.CajuBubble"
                        android:text="@string/welcome_how_caju_1" />

                </LinearLayout>

                <TextView
                    style="@style/Widget.CaLju.UserBubble"
                    android:text="@string/welcome_how_user_2" />

                <LinearLayout
                    style="@style/Widget.CaLju.CajuReply"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        style="@style/Widget.CaLju.CajuAvatar"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_caju_feliz" />

                    <TextView
                        style="@style/Widget.CaLju.CajuBubble"
                        android:text="@string/welcome_how_caju_2" />

                </LinearLayout>

                <TextView
                    style="@style/Widget.CaLju.UserBubble"
                    android:text="@string/welcome_how_user_3" />

                <LinearLayout
                    style="@style/Widget.CaLju.CajuReply"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        style="@style/Widget.CaLju.CajuAvatar"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_caju_pensando" />

                    <TextView
                        style="@style/Widget.CaLju.CajuBubble"
                        android:text="@string/welcome_how_caju_3" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </ScrollView>

    <TextView
        android:id="@+id/page_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="12dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/next"
        style="@style/Widget.CaLju.PrimaryAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/welcome_start"
        app:cornerRadius="28dp" />

</LinearLayout>
