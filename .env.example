# Modelo de variáveis de ambiente para desenvolvimento local.
# Copie este arquivo para .env e preencha os valores. O .env NÃO é versionado.

# Banco PostgreSQL de desenvolvimento (docker-compose.yml)
POSTGRES_DB=calju
POSTGRES_USER=calju
# Escolha uma senha própria; não reutilize senhas pessoais.
POSTGRES_PASSWORD=
# Porta no seu computador; mude se a 5432 já estiver em uso.
POSTGRES_PORT=5432
