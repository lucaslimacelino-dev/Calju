POSTGRES_DB=calju
POSTGRES_USER=calju
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Segredo que assina os tokens de acesso (Base64 de 32 bytes aleatórios ou mais).
# Gere um valor próprio e nunca o versione. Veja o README.
CALJU_JWT_SECRET=

# ID do cliente OAuth do tipo Web (Google Cloud). Não é segredo, mas fica aqui por ser de cada ambiente.
CALJU_GOOGLE_CLIENT_ID=
